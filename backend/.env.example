# ==============================================================================
# MEETING INTELLIGENCE PLATFORM — BACKEND CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT SETTINGS (Default values for running on localhost)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Faster-Whisper Model Settings
# Models: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload limit in MB
MAX_UPLOAD_SIZE_MB=500

# Local Storage directory (ephemeral scratchpad for media extraction)
DATA_DIR=data

# CORS Allowed Origins (Comma-separated list for local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. RENDER PRODUCTION SETTINGS (Environment Variables set in Render Dashboard)
# ------------------------------------------------------------------------------
# PORT is automatically injected by Render (e.g. 10000)
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# MAX_UPLOAD_SIZE_MB=500
# FRONTEND_URL=https://meetingx-frontend.onrender.com

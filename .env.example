# ==============================================================================
# MEETING INTELLIGENCE PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# Faster-Whisper Model Settings
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload limit in MB
MAX_UPLOAD_SIZE_MB=500

# Server settings (Local Dev)
HOST=0.0.0.0
PORT=8000
DATA_DIR=data

# Backend CORS Allowed Origins (Local Dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Production Deployed Frontend Origin (Render Web Service)
# FRONTEND_URL=https://meetingx-frontend.onrender.com

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Local dev: Leave empty to use Vite reverse proxy
# Production (Render Static Site): Set to Render backend URL
# VITE_API_URL=https://meetingx-backend.onrender.com
VITE_API_URL=

# ==========================================
# Meeting Intelligence Platform - Configuration
# Phase 1: Local Speech-to-Text Pipeline
# ==========================================

# Faster-Whisper Model Settings
# Available models: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3
WHISPER_MODEL=base

# Device: 'cpu' or 'cuda' (for NVIDIA GPU)
WHISPER_DEVICE=cpu

# Compute Type:
# For CPU: 'int8', 'float32'
# For CUDA GPU: 'float16', 'int8_float16', 'int8'
WHISPER_COMPUTE_TYPE=int8

# Maximum File Upload Size in Megabytes (default: 500 MB)
MAX_UPLOAD_SIZE_MB=500

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated or wildcard in dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage Directory for temporary uploads and extracted media
DATA_DIR=data
